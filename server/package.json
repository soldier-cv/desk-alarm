{
  "name": "@deskalarm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch dist/server/src/index.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "db:init": "node scripts/db-init.mjs",
    "mcp:stdio": "node dist/server/src/mcp/stdio.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "pg": "^8.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}
