# DeskAlarm 环境变量模板。复制成 .env 后填真实值，.env 不进版本库。
# 改完必须 docker compose up -d --force-recreate 才生效，
# docker compose restart 不会重新加载环境变量。
#
# 只有「每台部署不一样」的值放这里。调度频率、池大小、日志级别等
# 固定值直接写在 docker-compose.yml；提醒设置由各用户在客户端改。

# ---------------------------------------------------------------- 数据库
# 本地 Docker Desktop 用 db；生产填外部数据库地址
PGHOST=db
PGPORT=5432
PGDATABASE=desk_alarm_local
PGSCHEMA=desk_alarm
PGUSER=desk_alarm
PGPASSWORD=deskalarm

# ---------------------------------------------------------------- 网关
WEB_PORT=8091

# 管理员不在 env 里配：首次启动客户端会出现初始化页面，自行填用户名和两次密码
