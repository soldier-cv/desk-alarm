# DeskAlarm 环境变量模板。复制成 .env 后填真实值，.env 不进版本库。
# 改完必须 docker compose up -d --force-recreate 才生效，
# docker compose restart 不会重新加载环境变量。

# ---------------------------------------------------------------- 数据库
# PostgreSQL 18.6，填数据库服务器的地址
PGHOST=
PGPORT=5432
PGDATABASE=general_db

# 自己的 schema。general_db 是共用库，同库里还有其它项目，
# 往 public 塞表会和别的项目撞名，所以全部隔离在这一层
PGSCHEMA=desk_alarm

PGUSER=desk_alarm
# 口令不写进版本库。复制成 .env 后填真实值
PGPASSWORD=

# ---------------------------------------------------------------- 镜像
# 镜像仓库地址。docker-compose.yml 拼镜像名用它，CI 也往这里推；不设就是下面这个
REGISTRY_HOST=127.0.0.1:5000

# 网关端口（静态原型 + API 反代）。8080/8088/8090 已被别的服务占用
WEB_PORT=8091

# ---------------------------------------------------------------- 鉴权
# 客户端登录口令。留空用代码里的默认值 deskalarm，部署前必须改成自己的
DESKALARM_PASSCODE=

# ---------------------------------------------------------------- 调度
TICK_MS=1000
ROTATE_MS=400
MISSED_AFTER_MS=60000
DELIVERY_RETRY_MS=120000
DELIVERY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- 推送
# 没配这三项，Android 设备到点不会响，只会留在队列里等上线补发。
# 服务启动时日志会打一行 FCM 不可用，看到就说明这里没配
#FCM_PROJECT_ID=
#FCM_CLIENT_EMAIL=
#FCM_PRIVATE_KEY=

# ---------------------------------------------------------------- MCP
# agent 用的独立 token。留空则只能用登录 token 调 MCP
#MCP_TOKEN=

LOG_LEVEL=info
