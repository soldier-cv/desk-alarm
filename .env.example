# DeskAlarm 环境变量
# 这个文件不进版本库。改完必须 docker compose up -d --force-recreate 才生效，
# docker compose restart 不会重新加载环境变量。

# ---------------------------------------------------------------- 数据库
# 88 服务器上的 PostgreSQL 18.6
PGHOST=100.64.0.88
PGPORT=5432
PGDATABASE=general_db

# 自己的 schema。general_db 是共用的（有 image_gallery / porter 等项目），
# 往 public 塞表会和别的项目撞名，所以全部隔离在这一层
PGSCHEMA=desk_alarm

PGUSER=desk_alarm
PGPASSWORD=TpTohsACO3LBBU

# 网关端口（静态原型 + API 反代）。8080/8088/8090 都被本机别的服务占了
WEB_PORT=8091

# ---------------------------------------------------------------- 鉴权
# 客户端登录口令。改掉默认的 deskalarm
DESKALARM_PASSCODE=sk-desk-2026

# ---------------------------------------------------------------- 调度
TICK_MS=1000
ROTATE_MS=400
MISSED_AFTER_MS=60000
DELIVERY_RETRY_MS=120000
DELIVERY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- 推送
# 没配这三项，Android 设备到点不会响，只会留在队列里等上线补发。
# 服务启动时日志会打一行 FCM 不可用，看到就说明这里没配
#FCM_PROJECT_ID=
#FCM_CLIENT_EMAIL=
#FCM_PRIVATE_KEY=

# ---------------------------------------------------------------- MCP
# agent 用的独立 token。留空则只能用登录 token 调 MCP
#MCP_TOKEN=

LOG_LEVEL=info
