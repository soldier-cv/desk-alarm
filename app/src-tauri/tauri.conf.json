{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskAlarm",
  "version": "0.2.3",
  "identifier": "io.github.soldier-cv.deskalarm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DeskAlarm",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0B0C0D"
      },
      {
        "label": "takeover",
        "url": "takeover.html",
        "title": "DeskAlarm 正在呼叫你",
        "width": 940,
        "height": 660,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#07080A"
      },
      {
        "label": "capture",
        "url": "capture.html",
        "title": "快速记一条",
        "width": 560,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0B0C0D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "DeskAlarm"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMERDQTFBQzM3RkNBMEEKUldRS3luL0RHc29OTWdGRTlzM1l0YWtjSlJRbjZHSTBMS1dyMG1taDVuM2lRV1hWcHZlTXZadXIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "shortDescription": "桌面强提醒工具",
    "longDescription": "到点强提示的桌面工具，支持多设备推送"
  }
}
